type Query {
    accounts: [Account!]!
    accountById(id: ID!): Account
}

type Mutation {
    createAccount(input: AccountInput!): Account!
}

type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

enum AccountStatus {
    ACTIVE
    BLOCKED
}

input AccountInput {
    customerReference: String!
    currency: String!
    balance: Float!
}
